    },
    {
      "evidence_id": "E08",
      "material_id": "text",
      "locator": "Section 5.2, line 1703; Table 2/page 7 image",
      "quote": "MetaMem w/o Evolution, which disables the evolution of the meta-memory, and MetaMem w/o Self-Reflection, which removes the intermediate self-reflection step and directly generates optimization actions from the original responses.",
      "support_explanation": "表2：Qwen完整71.90、去反思70.02、去演化68.33；Llama69.08、68.33、66.42。支持构件相关性，但去演化初始存储未充分交代，不等同保留整个构建循环但移除最终文本的严格store-off；无等长静态指导/预算匹配替代编辑器。",
      "kind": "author_report",
      "material_hash": "f6875b2278483f1b96cca76f21cb0acad2af4e63fbd0760b6a0ee3ec67400f53"
    },
